{
  "name": "kurdish-sorani-subtitle-translator",
  "version": "1.0.0",
  "private": true,
  "description": "Browser-only subtitle translator for Kurdish Sorani. No APIs, no backend, no uploads.",
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
